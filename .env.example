# Copy to .env for local dev. .env is gitignored — never commit real secrets.
# Postgres credentials (used by both the db service and the backend).
POSTGRES_USER=tinkerer
POSTGRES_PASSWORD=tinkerer
POSTGRES_DB=tinkerer
# Backend connection string. Host 'db' is the compose service name.
DATABASE_URL=postgresql+psycopg://tinkerer:tinkerer@db:5432/tinkerer

# Dev defaults below. Replace minioadmin creds for any non-local deploy.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=tinkerer-lab

# Per-file size cap in bytes (2 GB placeholder).
MAX_FILE_SIZE=2147483648

# development | test | production
ENVIRONMENT=development
# Public origin the app is served from (what the browser sees).
PUBLIC_URL=http://localhost

# Google OAuth client (Google Cloud console → Credentials → OAuth client ID,
# type "Web application", redirect URI: {PUBLIC_URL}/api/auth/callback).
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Google Workspace domain allowed to log in (the part after @ in uni emails).
GOOGLE_HOSTED_DOMAIN=youruni.edu

# Session JWT signing secret — generate a long random string for any real deploy.
JWT_SECRET=generate-a-random-string-of-at-least-32-bytes
SESSION_TTL_SECONDS=604800

# Comma-separated emails that become staff on first login (bootstrap only).
STAFF_EMAILS=

# Per-user total storage cap in bytes (20 GB placeholder).
MAX_USER_STORAGE=21474836480
# Cleanup job: sweep cadence and how old an unconfirmed upload may get.
CLEANUP_INTERVAL_SECONDS=600
PENDING_MAX_AGE_SECONDS=3600
