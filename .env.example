# Copy to .env for local dev. .env is gitignored — never commit real secrets.
# Postgres credentials (used by both the db service and the backend).
POSTGRES_USER=tinkerer
POSTGRES_PASSWORD=tinkerer
POSTGRES_DB=tinkerer
# Backend connection string. Host 'db' is the compose service name.
DATABASE_URL=postgresql+psycopg://tinkerer:tinkerer@db:5432/tinkerer

# Dev defaults below. Replace minioadmin creds for any non-local deploy.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=tinkerer-lab

# Per-file size cap in bytes (2 GB placeholder). Must sit BELOW any body-size
# limit between the browser and this app — a tunnel that caps requests at
# 100 MB will kill a larger upload with an error the app cannot explain.
MAX_FILE_SIZE=2147483648

# development | test | production
ENVIRONMENT=development
# Public origin the app is served from (what the browser sees).
PUBLIC_URL=http://localhost

# Google OAuth client (Google Cloud console → Credentials → OAuth client ID,
# type "Web application", redirect URI: {PUBLIC_URL}/api/auth/callback).
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Google Workspace domain allowed to log in (the part after @ in uni emails).
GOOGLE_HOSTED_DOMAIN=youruni.edu

# Session JWT signing secret — generate a long random string for any real deploy.
JWT_SECRET=generate-a-random-string-of-at-least-32-bytes
SESSION_TTL_SECONDS=604800

# Comma-separated emails that become staff on first login (bootstrap only).
STAFF_EMAILS=

# Per-user total storage cap in bytes (20 GB placeholder).
MAX_USER_STORAGE=21474836480
# Cleanup job: sweep cadence and how old an unconfirmed upload may get.
CLEANUP_INTERVAL_SECONDS=600
PENDING_MAX_AGE_SECONDS=3600
# Landing slider slot count.
SLIDER_SIZE=8

# --- Borrowing log -------------------------------------------------------
# The lab's IANA timezone. Required: it decides "today" for return dates
# and overdue status (containers run in UTC).
LAB_TIMEZONE=Asia/Kolkata
# Furthest allowed return-by date, in days from today.
LOAN_MAX_DAYS=30
# Byte cap per loan photo (15 MB; photos are downscaled in the browser).
LOAN_PHOTO_MAX_SIZE=15728640
# Photos a borrower attaches when logging a loan (at least 1).
LOAN_MAX_PHOTOS=4

# Host the browser reaches MinIO through (nginx S3 route signs for this host).
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_SECURE=false

# Backup cadence. Postgres gets a pruned pg_dump; MinIO objects are mirrored
# into <BACKUP_PATH>/objects and are never pruned (see docker-compose.yml).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# --- Where data lives on disk -------------------------------------------
# A bare name is a Docker named volume (fine for a laptop). On a server set
# these to absolute host paths so the data is a real directory you can back
# up and `docker compose down -v` cannot erase. See docs/deployment.md.
PGDATA_PATH=pgdata
MINIODATA_PATH=miniodata
BACKUP_PATH=./backups

# --- How the site is published ------------------------------------------
# Port publishing for nginx. Behind a reverse proxy on the same host, use
# 127.0.0.1:80 so the container is not reachable from the network directly.
HTTP_BIND=80
# nginx.conf (HTTP; something else terminates TLS) or nginx-tls.conf (this
# host terminates TLS — then also set TLS_CERT_DIR and publish 443).
NGINX_CONF=nginx.conf
TLS_CERT_DIR=./nginx/certs
